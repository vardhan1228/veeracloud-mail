# Copy to .dev.vars for `wrangler dev`. .dev.vars is git-ignored.

# Encrypts the mailbox password held in each webmail session. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_SESSION_KEY=

# Optional: use real Firestore locally. Set DATA_STORE=firestore and paste the whole
# service-account key JSON on one line (Firebase console → Project settings → Service accounts).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Optional. Without it the dev API skips Turnstile. With it, both frontends need VITE_TURNSTILE_SITE_KEY.
# Cloudflare test secret that always passes:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Only when MAIL_PROVIDER=stalwart:
# STALWART_URL=https://mail.veeracloud.shop
# STALWART_ADMIN_USER=
# STALWART_ADMIN_PASSWORD=

// Cloudflare Worker for the API. See infrastructure/cloudflare/DEPLOYMENT.md.
// Secrets (never in this file), per environment with --env production:
//   wrangler secret put FIREBASE_SERVICE_ACCOUNT   (the whole Firebase service-account key JSON)
//   wrangler secret put MAIL_SESSION_KEY           (32 random bytes, base64)
//   wrangler secret put STALWART_ADMIN_USER
//   wrangler secret put STALWART_ADMIN_PASSWORD
//   wrangler secret put ADMIN_EMAILS               (comma-separated admin console emails; kept out of the public repo)
//   wrangler secret put TURNSTILE_SECRET_KEY       (optional but recommended)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veeracloud-mail-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // ---- Local development (`wrangler dev`) ----
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGINS": "http://localhost:5174,http://localhost:5175",
    "COMPANY_NAME": "HAVINS TECHNOLOGIES",
    "FIREBASE_PROJECT_ID": "mail-auth-dd889",
    "FIREBASE_AUTH_EMULATOR": "false",
    "ADMIN_EMAILS": "admin@company.test",
    "DEV_ALLOW_ADMIN_WITHOUT_MFA": "true",
    // "memory" needs no setup (data resets when the dev server restarts).
    // Put FIREBASE_SERVICE_ACCOUNT in .dev.vars and set "firestore" to use real Firestore.
    "DATA_STORE": "memory",
    "DEV_SEED": "true",
    // Built-in development mail server. Set "stalwart" + STALWART_URL to test a real one.
    "MAIL_PROVIDER": "mock",
  },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],

  "env": {
    "production": {
      "name": "veeracloud-mail-api",
      "routes": [{ "pattern": "api.veeracloud.shop", "custom_domain": true }],
      "triggers": { "crons": ["17 3 * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGINS": "https://admin.veeracloud.shop,https://webmail.veeracloud.shop",
        "COMPANY_NAME": "HAVINS TECHNOLOGIES",
        "FIREBASE_PROJECT_ID": "mail-auth-dd889",
        "FIREBASE_AUTH_EMULATOR": "false",
        "DATA_STORE": "firestore",
        "MAIL_PROVIDER": "stalwart",
        "STALWART_URL": "https://mail.veeracloud.shop",
      },
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
      ],
    },
  },
}

# Firebase web config (public values; they ship to every browser). Copy to .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: Cloudflare Turnstile site key. Without it, no widget is shown (the dev API skips the check).
VITE_TURNSTILE_SITE_KEY=
# API base. "/api" uses the Vite dev proxy; in production set https://api.<your-domain>.
VITE_API_URL=/api
